NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Percent-encode special characters in URL passwords.
DATABASE_URL=
# Docker development only:
MYSQL_DATABASE=alarbi
MYSQL_USER=alarbi
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
# Stable secrets: generated once by env:init, never on server start. Back up securely.
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOG_LEVEL=info
REQUIRE_OWNER_2FA=false
# Production: HOST=0.0.0.0, PORT=3000, NODE_ENV=production, COOKIE_SECURE=true,
# ALLOWED_ORIGINS=https://your-domain.example, TRUST_PROXY=true behind Hostinger's proxy.
# Append ?ssl=true to remote MySQL URLs; validated against Hostinger's certificate.
